{
  "extraKnownMarketplaces": {
    "portka-tools": {
      "source": {
        "source": "github",
        "repo": "cportka/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "repo-bootstrap@portka-tools": true,
    "app-website-evaluator@portka-tools": true
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(gh workflow:*)",
      "Bash(gh issue:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(sed -n:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(cmp:*)",
      "Bash(file:*)",
      "Bash(du:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote prune:*)",
      "Bash(git rm:*)",
      "Bash(git config user.name:*)",
      "Bash(git config user.email:*)",
      "Bash(bash tests/run-tests.sh)",
      "Bash(bash tests/cases/:*)",
      "Bash(bash scripts/stage-site.sh:*)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "Bash(npm root:*)",
      "Bash(gh api:*)",
      "WebSearch",
      "WebFetch",
      "mcp__github__pull_request_read",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__get_job_logs",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__actions_run_trigger",
      "mcp__github__get_file_contents",
      "mcp__github__list_issues",
      "mcp__github__search_issues",
      "mcp__github__issue_read",
      "mcp__github__issue_write",
      "mcp__github__add_issue_comment",
      "mcp__Claude_Code_Remote__subscribe_pr_activity",
      "mcp__Claude_Code_Remote__unsubscribe_pr_activity",
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__read_documentation"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git tag:*)",
      "Bash(git push --tags:*)",
      "Bash(gh pr merge --admin:*)",
      "Bash(gh workflow disable:*)",
      "Bash(gh run delete:*)",
      "Bash(gh release:*)"
    ]
  }
}
